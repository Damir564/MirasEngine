#version 460

// Hi-Z occlusion culling against the previous frame's depth pyramid. Occluded draws keep their
// command but get instanceCount = 0, so the CPU-built DrawRuns stay valid.
layout(local_size_x = 64) in;

struct TransformData {
    mat4 model;
    mat4 normal;
};

// Must match GpuCullBounds in engine/RenderTypes.h.
struct CullBounds {
    vec3 boundsMin;
    uint transformIndex;
    vec3 boundsMax;
    uint cullable;
};

// VkDrawIndexedIndirectCommand
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer TransformBuffer { TransformData transforms[]; };
layout(std430, set = 0, binding = 1) readonly buffer BoundsBuffer { CullBounds bounds[]; };
layout(std430, set = 0, binding = 2) buffer CommandBuffer { DrawCommand commands[]; };
layout(set = 0, binding = 3) uniform sampler2D depthPyramid;

// Must match CullPushConstants in engine/RenderTypes.h.
layout(push_constant) uniform Push {
    mat4 prevViewProj;
    vec4 viewRect;     // scene viewport of the previous frame in [0, 1] texture coordinates
    vec2 pyramidSize;  // size of pyramid level 0 in texels
    uint firstCommand;
    uint commandCount;
} pc;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.commandCount)
        return;
    const uint c = pc.firstCommand + i;
    const CullBounds b = bounds[c];
    if (b.cullable == 0u)
        return;

    const mat4 m = pc.prevViewProj * transforms[b.transformIndex].model;
    vec2 ndcMin = vec2(1e30);
    vec2 ndcMax = vec2(-1e30);
    float nearestDepth = 1.0;
    for (int k = 0; k < 8; ++k) {
        const vec3 corner = vec3((k & 1) != 0 ? b.boundsMax.x : b.boundsMin.x,
                                 (k & 2) != 0 ? b.boundsMax.y : b.boundsMin.y,
                                 (k & 4) != 0 ? b.boundsMax.z : b.boundsMin.z);
        const vec4 clip = m * vec4(corner, 1.0);
        // Crossing the camera plane: the projected box is unbounded, so keep the draw.
        if (clip.w <= 1e-4)
            return;
        const vec3 ndc = clip.xyz / clip.w;
        ndcMin = min(ndcMin, ndc.xy);
        ndcMax = max(ndcMax, ndc.xy);
        nearestDepth = min(nearestDepth, ndc.z);
    }
    if (nearestDepth <= 0.0)
        return;

    const vec2 uvMin = pc.viewRect.xy + (ndcMin * 0.5 + 0.5) * pc.viewRect.zw;
    const vec2 uvMax = pc.viewRect.xy + (ndcMax * 0.5 + 0.5) * pc.viewRect.zw;
    // Anything the previous frame did not see (off-screen there) cannot be judged from its depth.
    if (any(lessThan(uvMin, pc.viewRect.xy)) || any(greaterThan(uvMax, pc.viewRect.xy + pc.viewRect.zw)))
        return;

    // The level where the box spans at most one texel; the MAX-reduction bilinear fetch then covers it.
    const vec2 sizeTexels = (uvMax - uvMin) * pc.pyramidSize;
    const float level = ceil(log2(max(max(sizeTexels.x, sizeTexels.y), 1.0)));
    const float occluderDepth = textureLod(depthPyramid, (uvMin + uvMax) * 0.5, level).x;
    if (nearestDepth > occluderDepth)
        commands[c].instanceCount = 0u;
}
