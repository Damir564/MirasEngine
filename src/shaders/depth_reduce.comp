#version 460

// One level of the Hi-Z depth pyramid. The source sampler uses MAX reduction, so a bilinear fetch
// at the destination texel center returns the farthest depth of the 2x2 source footprint.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D srcDepth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D dstDepth;

// Must match PyramidPushConstants in engine/RenderTypes.h.
layout(push_constant) uniform Push {
    uvec2 dstSize;
} pc;

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, pc.dstSize)))
        return;
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.dstSize);
    imageStore(dstDepth, ivec2(pixel), vec4(textureLod(srcDepth, uv, 0.0).x));
}
